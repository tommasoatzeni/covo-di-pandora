  <!-- ============================================================
    SCRIPTS
    Eseguiti dal più specifico al più generico:
      chroot-scripts: dentro il sistema installato, prima del reboot
      post-scripts:   dopo il reboot, sistema avviato

    Usiamo chroot-scripts per la configurazione di sistema:
    operano direttamente sul filesystem installato con chroot,
    quindi i file creati sono già nel posto giusto al primo boot.

    IMPORTANTE: il contenuto degli script va in CDATA per evitare
    che caratteri speciali XML (<, >, &, ecc.) rompano il parsing.
    ============================================================ -->
  <scripts t="map">

    <chroot-scripts t="list">

      <!-- ========================================================
        SCRIPT 1: nftables — configurazione firewall
        Installa il file di configurazione nftables identico
        a quello testato su pandora (Tumbleweed).
        Il servizio nftables è già abilitato nella sezione services.
        ======================================================== -->
      <script t="map">
        <chrooted t="boolean">true</chrooted>
        <filename>01-nftables-config.sh</filename>
        <interpreter>shell</interpreter>
        <source><![CDATA[
#!/bin/bash
# Configurazione nftables — firewall statico minimale
# Regole: SSH in ingresso, ICMP, DHCP client, forward per bridge VM

cat > /etc/nftables.conf << 'EOF'
#!/usr/sbin/nft -f

flush ruleset

table inet pandora {

    chain input {
        type filter hook input priority filter; policy drop;

        # loopback sempre accettato
        iifname "lo" accept

        # connessioni già stabilite
        ct state established,related accept

        # pacchetti non validi scartati
        ct state invalid drop

        # ICMP diagnostica
        meta l4proto icmp accept
        meta l4proto ipv6-icmp accept

        # SSH
        tcp dport 22 accept

        # DHCP client (wicked)
        udp dport 68 accept
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        # traffico bridge VM — tutto permesso nella LAN
        iifname "br0" accept
        oifname "br0" accept

        ct state established,related accept
        ct state invalid drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
EOF

echo "nftables.conf installato"
        ]]></source>
      </script>

      <!-- ========================================================
        SCRIPT 2: SSH hardening
        Installa il drop-in sshd_config che disabilita
        autenticazione password e applica le restrizioni di sicurezza.
        KbdInteractiveAuthentication e UsePAM no sono necessari
        su openSUSE per evitare bypass via PAM.
        ======================================================== -->
      <script t="map">
        <chrooted t="boolean">true</chrooted>
        <filename>02-ssh-hardening.sh</filename>
        <interpreter>shell</interpreter>
        <source><![CDATA[
#!/bin/bash
# SSH hardening — solo autenticazione a chiave

mkdir -p /etc/ssh/sshd_config.d

cat > /etc/ssh/sshd_config.d/99-hardening.conf << 'EOF'
# Hardening SSH — pandora-nuc
# Solo autenticazione a chiave ed25519
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
X11Forwarding no
MaxAuthTries 3
LoginGraceTime 20
AllowUsers tommy
EOF

echo "SSH hardening configurato"
        ]]></source>
      </script>

      <!-- ========================================================
        SCRIPT 3: ottimizzazione wicked
        Riduce i timeout di attesa interfacce da 30s a 10s.
        Sicuro con interfacce statiche o DHCP su rete locale.
        ======================================================== -->
      <script t="map">
        <chrooted t="boolean">true</chrooted>
        <filename>03-wicked-tuning.sh</filename>
        <interpreter>shell</interpreter>
        <source><![CDATA[
#!/bin/bash
# Ottimizzazione wicked — riduce timeout boot

cat >> /etc/sysconfig/network/config << 'EOF'

## Ottimizzazione boot — riduce timeout attesa interfacce (default 30s)
## Sicuro con interfacce statiche o DHCP su rete locale
## Modificato da AutoYaST — pandora-nuc setup
WAIT_FOR_INTERFACES="10"
WICKED_ABORT_TIMEOUT="10"
EOF

# disabilita servizi wicked inutili
systemctl mask wickedd-auto4.service
systemctl mask wickedd-dhcp6.service

echo "wicked tuning applicato"
        ]]></source>
      </script>

      <!-- ========================================================
        SCRIPT 4: dracut — initrd minimale
        Rimuove moduli inutili su server headless:
          plymouth:  splash grafico, inutile senza display interattivo
          i18n:      internazionalizzazione, inutile in initrd
          drm:       driver grafico kernel mode, inutile headless
          suse-xfs:  supporto XFS, non usato (filesystem root: btrfs)
        Compressione zstd: migliore rapporto velocità/dimensione.
        ======================================================== -->
      <script t="map">
        <chrooted t="boolean">true</chrooted>
        <filename>04-dracut-minimal.sh</filename>
        <interpreter>shell</interpreter>
        <source><![CDATA[
#!/bin/bash
# initrd minimale — rimuove moduli inutili su server headless

mkdir -p /etc/dracut.conf.d

cat > /etc/dracut.conf.d/pandora-server.conf << 'EOF'
# pandora-nuc — server headless, no GUI
# Moduli omessi:
#   plymouth  — splash grafico
#   i18n      — internazionalizzazione
#   drm       — driver grafico
#   suse-xfs  — filesystem XFS non utilizzato
omit_dracutmodules+=" plymouth i18n drm suse-xfs "
compress="zstd"
EOF

# rigenera initrd con la nuova configurazione
dracut --force --kver $(uname -r)

echo "initrd minimale generato: $(ls -lh /boot/initrd-* | awk '{print $5, $9}')"
        ]]></source>
      </script>

      <!-- ========================================================
        SCRIPT 5: configurazione libvirt client
        Imposta qemu:///system come URI default per virsh.
        Con l'architettura modulare libvirt il default è
        qemu:///session (utente) — questa configurazione forza
        la connessione al demone di sistema.
        ======================================================== -->
      <script t="map">
        <chrooted t="boolean">true</chrooted>
        <filename>05-libvirt-client.sh</filename>
        <interpreter>shell</interpreter>
        <source><![CDATA[
#!/bin/bash
# configurazione libvirt client per utente tommy

mkdir -p /home/tommy/.config/libvirt
cat > /home/tommy/.config/libvirt/libvirt.conf << 'EOF'
# URI default per virsh — architettura modulare libvirt
# Senza questa impostazione virsh usa qemu:///session (utente)
# che non ha accesso al pool storage di sistema
uri_default = "qemu:///system"
EOF

chown -R tommy:users /home/tommy/.config

echo "libvirt client configurato per tommy"
        ]]></source>
      </script>

      <!-- ========================================================
        SCRIPT 6: moduli kernel KVM
        Carica kvm e kvm_intel al boot tramite modules-load.d.
        Necessario perché senza questo file i moduli non sopravvivono
        al reboot e libvirt crasha con "Impossibile aprire /dev/kvm".
        ======================================================== -->
      <script t="map">
        <chrooted t="boolean">true</chrooted>
        <filename>06-kvm-modules.sh</filename>
        <interpreter>shell</interpreter>
        <source><![CDATA[
#!/bin/bash
# caricamento automatico moduli KVM al boot

cat > /etc/modules-load.d/kvm.conf << 'EOF'
# Moduli KVM — caricati automaticamente al boot
# Necessari per libvirt/QEMU con architettura modulare
kvm
kvm_intel
EOF

echo "moduli KVM configurati per caricamento automatico"
        ]]></source>

      </script>
      <!-- ========================================================
        SCRIPT 7: nftables service file
        Su openSUSE Leap 15.6 il pacchetto nftables-0.9.8 non include
        il file di servizio systemd — il binario /usr/sbin/nft viene
        installato ma non esiste nftables.service nell'RPM.
        Questo script crea il service file manualmente e abilita
        il servizio, in modo che nftables parta automaticamente
        al boot e il firewall sia attivo prima della rete.
        ======================================================== -->
      <script t="map">
        <chrooted t="boolean">true</chrooted>
        <filename>07-nftables-service.sh</filename>
        <interpreter>shell</interpreter>
        <source><![CDATA[
#!/bin/bash
# creazione service file systemd per nftables
# necessario su Leap 15.6 — non incluso nel pacchetto nftables-0.9.8

cat > /etc/systemd/system/nftables.service << 'EOF'
[Unit]
Description=nftables firewall
DefaultDependencies=no
After=network-pre.target
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.conf
ExecReload=/usr/sbin/nft -f /etc/nftables.conf
ExecStop=/usr/sbin/nft flush ruleset

[Install]
WantedBy=multi-user.target
EOF

systemctl enable nftables
echo "nftables.service creato e abilitato"
        ]]></source>
      </script>

    </chroot-scripts>

