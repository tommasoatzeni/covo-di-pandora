  <!-- ============================================================
    BOOTLOADER
    GRUB2 con doppia console: display fisico + seriale
    console=tty0        → output su display fisico (monitor/ILO KVM)
    console=ttyS0       → output su porta seriale (ILO serial / debug)
    Timeout ridotto a 3s per boot rapido su server automatico
    ============================================================ -->
  <bootloader t="map">
    <global t="map">
      <append>console=tty0 console=ttyS0,115200n8 preempt=full mitigations=auto quiet security=apparmor</append>
      <cpu_mitigations>auto</cpu_mitigations>
      <gfxmode>auto</gfxmode>
      <hiddenmenu>false</hiddenmenu>
      <os_prober>false</os_prober>
      <secure_boot>true</secure_boot>
      <serial>serial --unit=0 --speed=115200 --parity=no --word=8</serial>
      <terminal>gfxterm serial</terminal>
      <timeout t="integer">3</timeout>
      <trusted_grub>false</trusted_grub>
      <update_nvram>true</update_nvram>
    </global>
    <loader_type>grub2</loader_type>
  </bootloader>

  <!-- ============================================================
    FIREWALL
    firewalld disabilitato — sostituito da nftables statico
    La configurazione nftables viene installata dalla sezione <scripts>
